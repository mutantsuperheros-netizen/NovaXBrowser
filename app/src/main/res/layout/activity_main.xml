<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ NovaX 4K Browser"
            android:textColor="#58A6FF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="👤 Account"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#30363D"
            android:layout_marginEnd="4dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <Button
            android:id="@+id/btnVipAd"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🎬 VIP Ad"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#238636"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F6FEB"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMiniPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎵 Playing in Background..."
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:singleLine="true"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMiniPlayPause"
            android:layout_width="68dp"
            android:layout_height="32dp"
            android:text="⏯️ Play"
            android:textSize="10sp"
            android:backgroundTint="#0D1117"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnMiniOpen"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:text="↗️ Open"
            android:textSize="10sp"
            android:backgroundTint="#238636"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnMiniClose"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:text="✖"
            android:textSize="10sp"
            android:backgroundTint="#DA3633"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1117"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/btnWallpaper"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="🎨 4K Photo/Video Theme"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#8957E5"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPinAudio"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="📌 Pin Audio"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#21262D"
                android:textColor="#C9D1D9" />

            <Button
                android:id="@+id/btnSaveCustomHome"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="💾 Save Home"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#238636"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1117"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="40dp"
            android:layout_height="42dp"
            android:text="🏠"
            android:backgroundTint="#21262D"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="#161B22"
            android:hint="Search or type URL..."
            android:textColorHint="#8B949E"
            android:textColor="#FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnGo"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:text="GO"
            android:textStyle="bold"
            android:backgroundTint="#238636"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTabs"
            android:layout_width="54dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:text="[ 1 ]"
            android:textStyle="bold"
            android:backgroundTint="#1F6FEB"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
